# --- Database (SQLite) ---
# Path to the local SQLite file. Created automatically on migrate / first query.
# Backup = copy this file (and data/signal/ if you use Signal).
SQLITE_PATH=data/santa.sqlite

# --- Better Auth ---
# Generate a strong secret, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
# Public base URL used for reveal links and the client (baked in at build).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# In production set these before `npm run build` (leave empty for local dev):
# NEXT_PUBLIC_BASE_PATH=/your-prefix
# NEXT_PUBLIC_APP_URL=https://example.com/your-prefix
# BETTER_AUTH_URL=https://example.com/your-prefix
# PORT=3001
# HOSTNAME=127.0.0.1

# Email of the organiser account. Required in production: the first signup
# must match this address. Later signups are always rejected.
# Locally you can leave it blank to accept any first signup.
ADMIN_EMAIL=

# --- Signal (optional) ---
# Link from Settings → Integrations (downloads go-signal into data/bin/).
# Optional CLI: npm run signal:link
# Protocol state + the `.linked` marker live in this directory.
SIGNAL_STORE_DIR=data/signal
# SIGNAL_DEVICE_NAME=Secret Santa
# Override the downloaded binary:
# SIGNAL_CLI=/path/to/go-signal
# GOSIGNAL_BIN_DIR=data/bin

# --- Organiser email verification (optional) ---
# When all four are set, the first organiser must verify their address
# before login. This is a boot-time switch only — invitation and
# verification messages are sent with the mailbox from
# Settings → Integrations (WhatsApp, SMTP/IMAP, and VAPID keys are not
# read from env). Configure that mailbox first, or signup will require
# verification and then fail to send it.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Secret Santa <santa@your.domain>
